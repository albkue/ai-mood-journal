# ============================================================
# ML Service Configuration
# ============================================================

# Topic Modeler Selection: "gensim" | "llm" | "zeroshot"
# - gensim: Traditional LDA (default, good for large corpora)
# - llm: Gemini/OpenAI-powered (best labels, needs API key)
# - zeroshot: Local zero-shot classification (privacy-friendly)
TOPIC_MODELER_TYPE=llm

# LLM Provider (only used when TOPIC_MODELER_TYPE=llm)
# "gemini" | "openai"
LLM_PROVIDER=gemini

# API Keys (only needed for LLM topic modeler)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Emotion Predictor Configuration
# ============================================================

# Emotion Predictor Selection: "keyword" | "bert" | "sklearn" | "keras" | "transformer"
# - keyword: Keyword matching (fallback, always works, no model needed)
# - bert: Pre-trained BERT on GoEmotions (use NOW, auto-downloads ~440MB)
# - sklearn: Random Forest + TF-IDF (friend's .pkl model)
# - keras: Bi-LSTM (friend's .h5 model, needs TensorFlow)
# - transformer: DistilBERT fine-tuned (friend's transformer model directory)
EMOTION_PREDICTOR_TYPE=bert

# BERT model variant (only if EMOTION_PREDICTOR_TYPE=bert)
# "bert" | "roberta" | "distilbert"
BERT_MODEL_VARIANT=bert

# Model file paths (for sklearn/keras/transformer - friend's models)
EMOTION_MODEL_PATH=
EMOTION_VECTORIZER_PATH=
EMOTION_TOKENIZER_PATH=
